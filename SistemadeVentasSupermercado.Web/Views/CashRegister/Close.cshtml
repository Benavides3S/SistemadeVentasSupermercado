@model SistemadeVentasSupermercado.Web.DTOs.CloseCashRegisterDTO

@{
    ViewData["Title"] = "Cerrar Caja";
}

<div class="pagetitle">
    <h1>Cerrar Caja</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Cajas</a></li>
            <li class="breadcrumb-item active">Cerrar</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <h3 class="m-0 font-weight-bold text-primary">Cierre de Caja</h3>
        </div>

        <div class="card-body mt-3">
            @if (ViewBag.CurrentCashRegister != null)
            {
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h5 class="card-title">Resumen de Caja Actual</h5>
                                <div class="row">
                                    <div class="col-6">
                                        <strong>Monto Inicial:</strong><br>
                                        <strong>Total Ventas:</strong><br>
                                        <strong>Total Efectivo:</strong><br>
                                        <strong>Total Tarjeta:</strong><br>
                                        <strong>Total Transferencias:</strong>
                                    </div>
                                    <div class="col-6 text-end">
                                        @ViewBag.CurrentCashRegister.InitialAmount.ToString("C2")<br>
                                        @((ViewBag.CurrentCashRegister.TotalSales ?? 0).ToString("C2"))<br>
                                        @((ViewBag.CurrentCashRegister.TotalCash ?? 0).ToString("C2"))<br>
                                        @((ViewBag.CurrentCashRegister.TotalCard ?? 0).ToString("C2"))<br>
                                        @((ViewBag.CurrentCashRegister.TotalTransfer ?? 0).ToString("C2"))
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <form asp-action="Close" method="post" class="row g-3">
                <input type="hidden" asp-for="CashRegisterId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-md-6">
                    <label asp-for="FinalCashAmount" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="FinalCashAmount" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <span asp-validation-for="FinalCashAmount" class="text-danger"></span>
                    <small class="form-text text-muted">Monto total en efectivo contado físicamente.</small>
                </div>

                <div class="col-12">
                    <label asp-for="Observations" class="form-label"></label>
                    <textarea asp-for="Observations" class="form-control" rows="3" placeholder="Observaciones del cierre..."></textarea>
                    <span asp-validation-for="Observations" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Advertencia:</strong> Una vez cerrada la caja, no podrás registrar más ventas en este turno.
                    </div>
                </div>

                <div class="col-12">
                    <div class="btn-group" role="group">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-lock"></i> Cerrar Caja
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancelar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
