@model SistemadeVentasSupermercado.Web.DTOs.CashRegisterDTO

@{
    ViewData["Title"] = "Resumen Diario";
}

<div class="pagetitle">
    <h1>Resumen Diario de Cajas</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Cajas</a></li>
            <li class="breadcrumb-item active">Resumen Diario</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <div class="row">
                <h3 class="m-0 font-weight-bold text-primary col-md-8">Resumen del Día</h3>
                <div class="col-md-4">
                    <form method="get" class="d-flex">
                        <input type="date" name="date" value="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" class="form-control me-2" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card-body mt-3">
            @if (Model.TotalSales > 0)
            {
                <div class="row">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <h5 class="card-title">Total Ventas</h5>
                                <h3>@Model.TotalSales?.ToString("C2")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <h5 class="card-title">Efectivo</h5>
                                <h3>@Model.TotalCash?.ToString("C2")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <h5 class="card-title">Tarjeta</h5>
                                <h3>@Model.TotalCard?.ToString("C2")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning text-dark">
                            <div class="card-body">
                                <h5 class="card-title">Transferencias</h5>
                                <h3>@Model.TotalTransfer?.ToString("C2")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    No hay datos de ventas para la fecha @ViewBag.SelectedDate.ToString("dd/MM/yyyy")
                </div>
            }

            <div class="row mt-4">
                <div class="col-12">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver a Cajas
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>