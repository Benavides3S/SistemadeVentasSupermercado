@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@model ProductDTO
@{
    ViewData["Title"] = "Editar producto";
}

<div class="pagetitle">
    <h1>Productos</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Producto</a></li>
            <li class="breadcrumb-item active">Editar Producto</li>
        </ol>
    </nav>
</div>

<section class="Product dashboard">
    <div class="card">
        <div class="card-header">
            <h3 class="m-0 font-weight-bold text-primary ">Editar producto</h3>

        </div>




        <div class="card-body">

            @* <h5 class="card-title text-primary">Editar Producto</h5> *@
            <partial name="_FormError" />

            <form asp-action="Edit" method="POST" class="row g-3">
                <input type="hidden" asp-for="Id" />

                <div class="col-md-12">
                    <div class="form-floating">
                        <input asp-for="Name" class="form-control" placeholder="@Html.DisplayFor(dto => dto.Name)">
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <partial name="_BarcodeField" />
                <div class="col-md-12">
                    <div class="form-floating">
                        <input asp-for="Description" class="form-control" placeholder="@Html.DisplayFor(dto => dto.Description)">
                        <label asp-for="Description"></label>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating">
                        <input asp-for="Price" type="number" step="any" class="form-control" placeholder="@Html.DisplayFor(dto => dto.Price)">
                        <label asp-for="Price"></label>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-12">
                    <label class="form-label">Stock actual</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-5 fw-semibold">@DisplayFormat.Quantity(Model.Stock) @Model.Unit.Abbreviation()</span>
                        @if (await _usersService.CurrentUserIsAuthorizedAsync("adjustInventory", "Inventario"))
                        {
                            <a asp-controller="Inventory" asp-action="Adjust" asp-route-productId="@Model.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-sliders"></i> Ajustar stock
                            </a>
                        }
                    </div>
                    <div class="form-text">
                        El stock ya no se cambia desde aquí: cada cambio se registra como un ajuste, con su motivo, en el historial de Inventario.
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-floating">
                        <select asp-for="CategoryId" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Categories)" class="form-select">
                            <option value="">Seleccione una categoría</option>
                        </select>
                        <label asp-for="CategoryId"></label>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">×</a>
                </div>
            </form>
        </div>

    </div>

</section>

@section Scripts {
    <script>
        $(document).ready(function() {

            $('.btnDelete').click(function(event) {

                event.preventDefault();

                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: "Something went wrong!",
                    footer: '<a href="#">Why do I have this issue?</a>'
                });
            });
        });
    </script>
}