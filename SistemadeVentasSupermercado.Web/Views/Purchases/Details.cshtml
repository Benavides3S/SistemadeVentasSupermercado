@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@model PurchaseDetailDTO

@{
    ViewData["Title"] = $"Compra #{Model.Number}";
    bool canCancel = Model.CanBeCancelled && await _usersService.CurrentUserIsAuthorizedAsync("cancelPurchases", "Compras");
}

<div class="pagetitle">
    <h1>Compra N.º @Model.Number</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Compras</a></li>
            <li class="breadcrumb-item active">Compra #@Model.Number</li>
        </ol>
    </nav>
</div>

<div class="mb-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al historial</a>
    @if (canCancel)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" id="cancelForm" class="d-inline">
            <input type="hidden" name="Reason" id="cancelReason" />
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-octagon"></i> Anular compra</button>
        </form>
    }
</div>

<section class="section">
    @if (Model.Status == PurchaseStatus.Cancelled)
    {
        <div class="alert alert-secondary" role="alert">
            <div class="fw-bold"><i class="bi bi-x-octagon"></i> COMPRA ANULADA</div>
            @if (Model.CancelledAtUtc.HasValue)
            {
                <div>Anulada: @DisplayFormat.DateTimeColombia(Model.CancelledAtUtc.Value)</div>
            }
            @if (Model.CancelledByName != null)
            {
                <div>Por: @Model.CancelledByName</div>
            }
            @if (Model.CancelReason != null)
            {
                <div>Motivo: @Model.CancelReason</div>
            }
            <div class="small mt-1">El stock que sumó esta compra ya se descontó del inventario. El último costo de cada producto vuelve al de su compra anterior (si esta compra era la más reciente).</div>
        </div>
    }

    <div class="card">
        <div class="card-body pt-3">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="text-muted small">Proveedor</div>
                    <div class="fw-semibold">@Model.SupplierName</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Factura del proveedor</div>
                    <div class="fw-semibold">@(Model.SupplierInvoiceNumber ?? "—")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Estado</div>
                    <div>
                        @if (Model.Status == PurchaseStatus.Completed)
                        {
                            <span class="badge bg-success">@Model.Status.Label()</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Status.Label()</span>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Fecha</div>
                    <div class="fw-semibold">@DisplayFormat.DateTimeColombia(Model.CreatedAtUtc)</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Registró</div>
                    <div class="fw-semibold">@Model.UserName</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="col-12">
                        <div class="text-muted small">Notas</div>
                        <div>@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body pt-3">
            <h5 class="card-title py-0">Productos</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Costo</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PurchaseDetailLineDTO line in Model.Items)
                        {
                            <tr>
                                <td>@line.ProductName</td>
                                <td class="text-end">@DisplayFormat.Quantity(line.Quantity) @line.Unit.Abbreviation()</td>
                                <td class="text-end">@DisplayFormat.Money(line.UnitCost) / @line.Unit.Abbreviation()</td>
                                <td class="text-end">@DisplayFormat.Money(line.Total)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total</th>
                            <th class="text-end fs-5">@DisplayFormat.Money(Model.Total)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Pide el motivo antes de anular (obligatorio, máximo 200 caracteres).
        const cancelForm = document.getElementById('cancelForm');
        if (cancelForm) {
            cancelForm.addEventListener('submit', function (event) {
                if (cancelForm.dataset.confirmed === 'true') return;
                event.preventDefault();

                Swal.fire({
                    icon: 'warning',
                    title: '¿Anular la compra #@Model.Number?',
                    text: 'Se descontará del inventario lo que esta compra sumó. Solo se puede si todavía hay suficiente stock (si parte ya se vendió, se rechaza). No se puede deshacer.',
                    input: 'text',
                    inputLabel: 'Motivo de la anulación',
                    inputAttributes: { maxlength: '200' },
                    showCancelButton: true,
                    confirmButtonText: 'Sí, anular',
                    cancelButtonText: 'No',
                    inputValidator: value => (!value || !value.trim()) ? 'El motivo es obligatorio' : undefined
                }).then(result => {
                    if (result.isConfirmed) {
                        document.getElementById('cancelReason').value = result.value.trim();
                        cancelForm.dataset.confirmed = 'true';
                        cancelForm.submit();
                    }
                });
            });
        }
    </script>
}
