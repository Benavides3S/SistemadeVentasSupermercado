@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@using SistemadeVentasSupermercado.Web.Core.Pagination
@model PaginationResponse<SupplierDTO>

@{
    ViewData["Title"] = "Proveedores";
}

<div class="pagetitle">
    <h1>Proveedores</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item active">Proveedores</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <div class="row">
                <h3 class="m-0 font-weight-bold text-primary col-md-11">Proveedores</h3>
                @if (await _usersService.CurrentUserIsAuthorizedAsync("createSuppliers", "Proveedores"))
                {
                    <div class="col-md-1">
                        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i></a>
                    </div>
                }
            </div>
        </div>

        <div class="card-body mt-3">
            <form asp-action="Index" class="navbar-search" method="GET">
                <input type="hidden" name="Page" value="@Model.CurrentPage" />
                <div class="row mt-3">
                    <div class="col-md-auto">
                        <select name="RecordsPerPage" class="form-select bg-light border-0 small" asp-for="RecordsPerPage">
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>
                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control bg-light border-0 small" placeholder="Buscar por nombre o NIT..." asp-for="Filter" />
                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
            </form>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>NIT / Documento</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.List != null && Model.List.Any())
                    {
                        foreach (SupplierDTO item in Model.List)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.TaxId</td>
                                <td>@item.Phone</td>
                                <td>@item.Email</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    @if (await _usersService.CurrentUserIsAuthorizedAsync("updateSuppliers", "Proveedores"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil-fill"></i></a>
                                    }

                                    @if (await _usersService.CurrentUserIsAuthorizedAsync("deleteSuppliers", "Proveedores"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" style="display: contents;">
                                            <button class="btn btn-sm btn-danger btnDelete"><i class="bi bi-trash-fill"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay proveedores registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>

            @await Html.PartialAsync("_PaginationComponent", Model)
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btnDelete').click(function (event) {
                event.preventDefault();
                Swal.fire({
                    icon: "question",
                    title: "¿Desea eliminar este proveedor?",
                    text: "No podrá revertirlo",
                    showCancelButton: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        $(this).closest('form').submit();
                    }
                });
            });
        });
    </script>
}
