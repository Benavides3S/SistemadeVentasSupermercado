@model List<SistemadeVentasSupermercado.Web.DTOs.SaleDTO>

@{
    ViewData["Title"] = "Reporte Diario de Ventas";
}

<div class="pagetitle">
    <h1>Reporte Diario de Ventas</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Ventas</a></li>
            <li class="breadcrumb-item active">Reporte Diario</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <div class="row">
                <h3 class="m-0 font-weight-bold text-primary col-md-8">Ventas del Día</h3>
                <div class="col-md-4">
                    <form method="get" class="d-flex">
                        <input type="date" name="date" value="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" class="form-control me-2" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card-body mt-3">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>N° Venta</th>
                                <th>Hora</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Método Pago</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in Model)
                            {
                                <tr>
                                    <td>@sale.SaleNumber</td>
                                    <td>@sale.SaleDate.ToString("HH:mm")</td>
                                    <td>@(sale.ClientName ?? "Cliente General")</td>
                                    <td>@sale.TotalAmount.ToString("C2")</td>
                                    <td>@sale.PaymentMethod</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@sale.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-active">
                            <tr>
                                <td colspan="3" class="text-end"><strong>Total del Día:</strong></td>
                                <td colspan="3" class="fw-bold">
                                    @Model.Sum(s => s.TotalAmount).ToString("C2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    No hay ventas registradas para la fecha @ViewBag.SelectedDate.ToString("dd/MM/yyyy")
                </div>
            }

            <div class="row mt-3">
                <div class="col-12">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver a Ventas
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>