<!-- ======= Header ======= -->
﻿@using SistemadeVentasSupermercado.Web.Data.Entities
@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IAuthorizationPinService _pinService
@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IProfilePhotoService _photoService

@{
    User? user;

    try
    {
        user = await _usersService.GetUserByEmailAsync(User.Identity.Name);
    }
    catch
    {
        user = null;
    }
}

<header id="header" class="header fixed-top d-flex align-items-center">

    <div class="d-flex align-items-center justify-content-between">
        <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
            <img src="~/assets/img/logo.png" alt="">
            <span class="d-none d-lg-block">Sistema de Ventas</span>
        </a>
        <i class="bi bi-list toggle-sidebar-btn"></i>
    </div>

    <nav class="header-nav ms-auto">
        <ul class="d-flex align-items-center">

            @if (user is not null)
            {
                <li class="nav-item me-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-lock-now title="Bloquear la pantalla">
                        <i class="bi bi-lock"></i> <span class="d-none d-sm-inline">Bloquear</span>
                    </button>
                </li>
            }

            <li class="nav-item dropdown pe-3">

                @if (user is not null)
                {     
                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                        <partial name="_Avatar" model="(user.FirstName, user.LastName, await _photoService.GetVersionAsync(User.Identity!.Name!))" />
                        <span class="d-none d-md-block dropdown-toggle ps-2">@user.FirstName.Substring(0, 1) . @user.LastName</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>@user.FullName</h6>
                            <span>@user.SistemaVentasRole.Name</span>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="UpdateUser">
                                <i class="bi bi-person"></i>
                                <span>Mi Perfil</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="ChangePassword">
                                <i class="bi bi-key"></i>
                                <span>Cambiar contraseña</span>
                            </a>
                        </li>
                        @if (await _pinService.CanHavePinAsync(User.Identity!.Name!))
                        {
                            <li>
                                <a class="dropdown-item d-flex align-items-center" asp-controller="Account" asp-action="AuthorizationPin">
                                    <i class="bi bi-shield-check"></i>
                                    <span>Mi PIN de autorización</span>
                                </a>
                            </li>
                        }
                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item d-flex align-items-center" asp-action="Logout" asp-controller="Account">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Cerrar sesión</span>
                            </a>
                        </li>

                    </ul>
                }
                else
                {
                    <a class="nav-link dropdown-toggle" asp-action="Login" asp-controller="Account">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Iniciar sesión</span>
                    </a>
                }

            </li>

        </ul>
    </nav>

</header>