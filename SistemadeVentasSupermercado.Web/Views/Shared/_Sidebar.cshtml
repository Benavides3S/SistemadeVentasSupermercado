<!-- ======= Sidebar ======= -->

@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService

<aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

        <li class="nav-item">
            <a class="nav-link " asp-controller="Home" asp-action="Index">
                <i class="bi bi-house"></i>
                <span>Inicio</span>
            </a>
        </li>

        @if (await _usersService.CurrentUserIsAuthorizedAsync("createSales", "Ventas"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Sales" asp-action="Create">
                    <i class="bi bi-cart3"></i><span>Punto de venta</span>
                </a>
            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showSales", "Ventas"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Sales" asp-action="Index">
                    <i class="bi bi-receipt"></i><span>Ventas</span>
                </a>
            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("manageCashSessions", "Caja"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="CashSessions" asp-action="Current">
                    <i class="bi bi-safe"></i><span>Mi caja</span>
                </a>
            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showCashSessions", "Caja"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="CashSessions" asp-action="Index">
                    <i class="bi bi-journal-check"></i><span>Turnos de caja</span>
                </a>
            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showReports", "Reportes"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart-line"></i><span>Reportes</span>
                </a>
            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showProducts" , "Productos"))
        {
            <li class="nav">
                <a class="nav-link collapsed" asp-controller="Product" asp-action="Index">
                    <i class="bi bi-book"></i><span>Productos</span>
                </a>

            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showCategories", "Categorias"))
        {
            <li class="nav">
                <a class="nav-link collapsed" asp-controller="Category" asp-action="Index">
                    <i class="bi bi-tags"></i><span>Categorías</span>
                </a>
            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showSuppliers", "Proveedores"))
        {
            <li class="nav">
                <a class="nav-link collapsed" asp-controller="Suppliers" asp-action="Index">
                    <i class="bi bi-truck"></i><span>Proveedores</span>
                </a>
            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showClients", "Clientes"))
        {
            <li class="nav">
                <a class="nav-link collapsed" asp-controller="Client" asp-action="Index">
                    <i class="bi bi-person-add"></i><span>Clientes</span>
                </a>

            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showUsers", "Usuarios"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-person"></i> <span>Usuarios</span>
                </a>
            </li>
        }

        @if (await _usersService.CurrentUserIsAuthorizedAsync("showRoles", "Roles"))
        {
            <li class="nav-item">
                <a class="nav-link collapsed" asp-controller="Roles" asp-action="Index">
                    <i class="bi bi-lock"></i> <span>Roles</span>
                </a>
            </li>
        }


    </ul>

</aside>