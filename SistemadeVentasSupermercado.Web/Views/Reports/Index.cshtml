@model DailySalesReportDTO?

@{
    ViewData["Title"] = "Reportes";
    DateOnly from = (DateOnly)ViewBag.From;
    DateOnly to = (DateOnly)ViewBag.To;
    List<TopProductDTO> top = (List<TopProductDTO>)ViewBag.Top;
    BusinessOptions business = (BusinessOptions)ViewBag.Business;
    string fromValue = from.ToString("yyyy-MM-dd");
    string toValue = to.ToString("yyyy-MM-dd");
}

<div class="pagetitle no-print">
    <h1>Reportes</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item active">Reportes</li>
        </ol>
    </nav>
</div>

@* Encabezado que solo aparece al imprimir o guardar como PDF. *@
<div class="print-only mb-3">
    <h4 class="mb-0">@business.Nombre</h4>
    <div>Reporte de ventas del @from.ToString("dd/MM/yyyy") al @to.ToString("dd/MM/yyyy")</div>
</div>

<section class="section">
    <div class="card no-print">
        <div class="card-body pt-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <div class="col-sm-4 col-md-3">
                    <label for="From" class="form-label">Desde</label>
                    <input type="date" id="From" name="From" value="@fromValue" class="form-control" required />
                </div>
                <div class="col-sm-4 col-md-3">
                    <label for="To" class="form-label">Hasta</label>
                    <input type="date" id="To" name="To" value="@toValue" class="form-control" required />
                </div>
                <div class="col-sm-4 col-md-6 d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Ver</button>
                    <a asp-action="Excel" asp-route-From="@fromValue" asp-route-To="@toValue" class="btn btn-success">
                        <i class="bi bi-file-earmark-excel"></i> Excel
                    </a>
                    <button type="button" class="btn btn-outline-secondary" onclick="window.print()" title="En la ventana de impresión elige &quot;Guardar como PDF&quot;">
                        <i class="bi bi-file-earmark-pdf"></i> Imprimir / PDF
                    </button>
                </div>
            </form>
            <div class="form-text">Las fechas son días de Colombia. Las devoluciones se cuentan el día en que se hicieron. Máximo 366 días.</div>
        </div>
    </div>

    @if (Model != null)
    {
        @* ---------- Resumen ---------- *@
        <div class="row">
            <div class="col-6 col-lg-3">
                <div class="card"><div class="card-body pt-3">
                    <div class="text-muted small">Ventas</div>
                    <div class="fs-4 fw-bold">@Model.Totals.SalesCount</div>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card"><div class="card-body pt-3">
                    <div class="text-muted small">Total vendido</div>
                    <div class="fs-4 fw-bold">@DisplayFormat.Money(Model.Totals.SalesTotal)</div>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card"><div class="card-body pt-3">
                    <div class="text-muted small">Devoluciones</div>
                    <div class="fs-4 fw-bold">@DisplayFormat.Money(Model.Totals.ReturnsTotal)</div>
                </div></div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card"><div class="card-body pt-3">
                    <div class="text-muted small">Neto</div>
                    <div class="fs-4 fw-bold text-success">@DisplayFormat.Money(Model.Totals.NetTotal)</div>
                </div></div>
            </div>
        </div>

        @* ---------- Ventas por día ---------- *@
        <div class="card">
            <div class="card-body pt-3">
                <h5 class="card-title py-0">Ventas por día</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th class="text-end">Ventas</th>
                                <th class="text-end">Efectivo</th>
                                <th class="text-end">Tarjeta</th>
                                <th class="text-end">Transferencia</th>
                                <th class="text-end">Total vendido</th>
                                <th class="text-end">Devoluciones</th>
                                <th class="text-end">Neto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DailySalesRowDTO day in Model.Days)
                            {
                                bool empty = day.SalesCount == 0 && day.ReturnsCount == 0;
                                <tr class="@(empty ? "text-muted" : "")">
                                    <td>@day.Date.ToString("ddd dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-CO"))</td>
                                    <td class="text-end">@day.SalesCount</td>
                                    <td class="text-end">@DisplayFormat.Money(day.CashTotal)</td>
                                    <td class="text-end">@DisplayFormat.Money(day.CardTotal)</td>
                                    <td class="text-end">@DisplayFormat.Money(day.TransferTotal)</td>
                                    <td class="text-end">@DisplayFormat.Money(day.SalesTotal)</td>
                                    <td class="text-end">@(day.ReturnsCount > 0 ? $"({day.ReturnsCount}) {DisplayFormat.Money(day.ReturnsTotal)}" : "—")</td>
                                    <td class="text-end fw-semibold">@DisplayFormat.Money(day.NetTotal)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold">
                            <tr>
                                <td>TOTAL</td>
                                <td class="text-end">@Model.Totals.SalesCount</td>
                                <td class="text-end">@DisplayFormat.Money(Model.Totals.CashTotal)</td>
                                <td class="text-end">@DisplayFormat.Money(Model.Totals.CardTotal)</td>
                                <td class="text-end">@DisplayFormat.Money(Model.Totals.TransferTotal)</td>
                                <td class="text-end">@DisplayFormat.Money(Model.Totals.SalesTotal)</td>
                                <td class="text-end">@DisplayFormat.Money(Model.Totals.ReturnsTotal)</td>
                                <td class="text-end">@DisplayFormat.Money(Model.Totals.NetTotal)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        @* ---------- Más vendidos ---------- *@
        <div class="card">
            <div class="card-body pt-3">
                <h5 class="card-title py-0">Productos más vendidos (por dinero neto)</h5>
                @if (top.Count == 0)
                {
                    <p class="text-muted">No hubo ventas en este rango.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Producto</th>
                                    <th class="text-end">Cantidad neta</th>
                                    <th class="text-end">Vendido</th>
                                    <th class="text-end">Devuelto</th>
                                    <th class="text-end">Neto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < top.Count; i++)
                                {
                                    TopProductDTO p = top[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@p.ProductName</td>
                                        <td class="text-end">@DisplayFormat.Quantity(p.NetQuantity) @p.Unit.Abbreviation()</td>
                                        <td class="text-end">@DisplayFormat.Money(p.SalesTotal)</td>
                                        <td class="text-end">@(p.ReturnedTotal > 0 ? DisplayFormat.Money(p.ReturnedTotal) : "—")</td>
                                        <td class="text-end fw-semibold">@DisplayFormat.Money(p.NetTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-text no-print">En pantalla se muestran los 20 primeros; el Excel trae hasta 100.</div>
                }
            </div>
        </div>
    }
</section>

<style>
    .print-only { display: none; }

    @@media print {
        @@page { size: letter; margin: 12mm; }

        #header, #sidebar, #footer, .back-to-top, .no-print, .notyf { display: none !important; }
        .print-only { display: block; }
        body { background: #fff !important; }
        #main { margin: 0 !important; padding: 0 !important; }
        .card { box-shadow: none !important; border: 0 !important; }
        .table { font-size: 11px; }
        thead { display: table-header-group; } /* repite los títulos en cada hoja */
        tr { page-break-inside: avoid; }
    }
</style>
