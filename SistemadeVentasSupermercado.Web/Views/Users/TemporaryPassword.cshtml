@model TemporaryPasswordDTO

@{
    ViewData["Title"] = Model.IsNewUser ? "Usuario creado" : "Contraseña restablecida";
}

<div class="pagetitle">
    <h1>Usuarios</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Usuarios</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-check-circle text-success"></i>
                        @(Model.IsNewUser ? "Usuario creado" : "Contraseña restablecida")
                    </h5>

                    <p class="mb-1"><strong>@Model.FullName</strong></p>
                    <p class="text-muted">Usuario para iniciar sesión: <strong>@Model.Email</strong></p>

                    <label class="form-label" for="temporaryPassword">Contraseña temporal</label>
                    <div class="input-group mb-3">
                        <input id="temporaryPassword" class="form-control form-control-lg font-monospace"
                               value="@Model.TemporaryPassword" readonly autocomplete="off">
                        <button type="button" class="btn btn-outline-primary" id="btnCopy" title="Copiar">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Esta contraseña solo se muestra una vez.</strong> Entrégala a la persona en privado.
                        Al iniciar sesión, el sistema le pedirá cambiarla por una propia.
                        Si se pierde, usa "Restablecer contraseña" en la lista de usuarios.
                    </div>

                    <div class="text-center">
                        <a asp-action="Index" class="btn btn-primary">Volver a usuarios</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('temporaryPassword');
            const button = document.getElementById('btnCopy');
            const original = button.innerHTML;
            let timer;

            button.addEventListener('click', async () => {
                // navigator.clipboard solo existe con HTTPS o en localhost; si no, se selecciona el texto.
                let copied = false;
                try {
                    await navigator.clipboard.writeText(input.value);
                    copied = true;
                } catch {
                    input.select();
                    copied = document.execCommand('copy');
                }

                // Aviso visible por 2 segundos.
                button.classList.remove('btn-outline-primary', 'btn-success', 'btn-warning');
                if (copied) {
                    button.classList.add('btn-success');
                    button.innerHTML = '<i class="bi bi-check-lg"></i> Copiada';
                } else {
                    button.classList.add('btn-warning');
                    button.innerHTML = 'Cópiala a mano (Ctrl+C)';
                }
                clearTimeout(timer);
                timer = setTimeout(() => {
                    button.classList.remove('btn-success', 'btn-warning');
                    button.classList.add('btn-outline-primary');
                    button.innerHTML = original;
                }, 2000);
            });
        })();
    </script>
}
