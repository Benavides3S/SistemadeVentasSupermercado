@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@model SaleReturnDetailDTO

@{
    ViewData["Title"] = $"Devolución #{Model.Number}";
    BusinessOptions business = (BusinessOptions)ViewBag.Business;

    // La venta se abre en el historial o, para el cajero, en "Anular o devolver".
    bool showSales = await _usersService.CurrentUserIsAuthorizedAsync("showSales", "Ventas");
    bool canAssist = !showSales && await _usersService.CurrentUserIsAuthorizedAsync("createSales", "Ventas");
    string? saleUrl = showSales ? Url.Action("Details", "Sales", new { id = Model.SaleId })
        : canAssist ? Url.Action("Assist", "Sales", new { number = Model.SaleNumber })
        : null;
}

<div class="pagetitle no-print">
    <h1>Comprobante de devolución</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            @if (saleUrl != null)
            {
                <li class="breadcrumb-item"><a href="@saleUrl">Venta #@Model.SaleNumber</a></li>
            }
            <li class="breadcrumb-item active">Devolución #@Model.Number</li>
        </ol>
    </nav>
</div>

<div class="no-print mb-3 d-flex gap-2 justify-content-center">
    <button type="button" class="btn btn-primary" onclick="window.print()">
        <i class="bi bi-printer"></i> Imprimir
    </button>
    @if (saleUrl != null)
    {
        <a href="@saleUrl" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Ver la venta
        </a>
    }
</div>

<div class="receipt">
    <div class="text-center">
        <div class="receipt-title">@business.Nombre</div>
        @if (!string.IsNullOrWhiteSpace(business.Nit))
        {
            <div>NIT @business.Nit</div>
        }
        <div class="receipt-banner">DEVOLUCIÓN</div>
    </div>

    <hr />

    <div>Devolución N.º <strong>@Model.Number</strong></div>
    <div>Venta N.º @Model.SaleNumber</div>
    <div>Fecha: @DisplayFormat.DateTimeColombia(Model.CreatedAtUtc)</div>
    <div>Atendió: @Model.UserName</div>
    @if (Model.AuthorizedByName != null)
    {
        <div>Autorizó: @Model.AuthorizedByName</div>
    }
    <div>Motivo: @Model.Reason</div>

    <hr />

    @foreach (SaleReturnDetailLineDTO line in Model.Items)
    {
        <div class="receipt-line">
            <div>@line.ProductName @(line.Restocked ? "" : "(no reintegrado)")</div>
            <div class="d-flex justify-content-between">
                <span>@DisplayFormat.Quantity(line.Quantity) @line.Unit.Abbreviation() × @DisplayFormat.Money(line.UnitPrice)</span>
                <span>@DisplayFormat.Money(line.Total)</span>
            </div>
        </div>
    }

    <hr />

    <div class="d-flex justify-content-between receipt-total">
        <span>REEMBOLSO</span>
        <span>@DisplayFormat.Money(Model.Total)</span>
    </div>
    <div class="d-flex justify-content-between">
        <span>Método</span>
        <span>@Model.RefundMethod.Label()</span>
    </div>

    <hr />

    <div class="mt-4">Firma cliente: ___________________</div>
    <div class="text-center small mt-2">Este documento no es una factura electrónica.</div>
</div>

<link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />
