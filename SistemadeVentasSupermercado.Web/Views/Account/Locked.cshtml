@{
    Layout = null;
    string? returnUrl = ViewBag.ReturnUrl as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Pantalla bloqueada - Sistema de Ventas</title>
    @await Html.PartialAsync("_Styles")
</head>
<body class="bg-light">
    <main class="container" style="max-width: 420px;">
        <div class="card mt-5">
            <div class="card-body text-center pt-4">
                <h1 class="h4"><i class="bi bi-lock"></i> Pantalla bloqueada</h1>
                <p class="mb-3">Sesión de <strong>@User.Identity!.Name</strong></p>

                <partial name="_FormError" />

                <form asp-action="Locked" method="post">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <label for="password" class="visually-hidden">Contraseña</label>
                    @* Sin "autofocus": lo que escriba el lector de códigos no debe caer aquí. *@
                    <input type="password" id="password" name="password" class="form-control mb-2"
                           placeholder="Tu contraseña" autocomplete="current-password" required />
                    <button type="submit" class="btn btn-primary w-100">Desbloquear</button>
                </form>

                <a asp-controller="Account" asp-action="Logout" class="btn btn-link mt-2">No soy yo: cerrar sesión</a>
            </div>
        </div>
    </main>

    <script>
        // Avisa a las demás pestañas de que la sesión está bloqueada.
        try { localStorage.setItem('sv-bloqueo', 'bloqueada'); } catch { }
    </script>
</body>
</html>
