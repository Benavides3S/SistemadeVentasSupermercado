@model ChangePasswordDTO

@{
    ViewData["Title"] = "Cambiar contraseña";
    bool mustChange = ViewBag.MustChange == true;
}

<div class="pagetitle">
    <h1>Cambiar contraseña</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Cambiar contraseña</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Cambiar contraseña</h5>

                    @if (mustChange)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-shield-lock"></i>
                            Estás usando una contraseña temporal. Para seguir, escribe una contraseña nueva que solo tú conozcas.
                        </div>
                    }

                    <form asp-action="ChangePassword" method="POST" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Contraseña actual">
                                <label asp-for="CurrentPassword"></label>
                                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                            </div>
                            @if (mustChange)
                            {
                                <div class="form-text">Es la contraseña temporal que te entregó el administrador.</div>
                            }
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Contraseña nueva">
                                <label asp-for="NewPassword"></label>
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>
                            <div class="form-text">
                                Mínimo 8 caracteres, con al menos una mayúscula, una minúscula y un número.
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmar contraseña nueva">
                                <label asp-for="ConfirmPassword"></label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
                            @if (mustChange)
                            {
                                <a asp-action="Logout" class="btn btn-secondary">Cerrar sesión</a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
