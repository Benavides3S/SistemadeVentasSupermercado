@model AccountUserDTO
@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IProfilePhotoService PhotoService

@{
    ViewData["Title"] = "Mi perfil";
    long? photoVersion = await PhotoService.GetVersionAsync(User.Identity!.Name!);
}

<div class="pagetitle">
    <h1>Mi perfil</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Editar Usuario</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card" id="profilePhoto" data-upload-url="@Url.Action("UploadPhoto", "Account")">
        <div class="card-body">
            <h5 class="card-title">Foto de perfil</h5>

            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="sv-foto-grande">
                    <div data-photo-current>
                        <partial name="_Avatar" model="(Model.FirstName, Model.LastName, photoVersion)" />
                    </div>
                    <canvas class="sv-avatar d-none" width="256" height="256" aria-label="Así quedará tu foto"></canvas>
                </div>

                <div class="flex-grow-1" style="min-width: 220px; max-width: 420px;">
                    <label for="photoFile" class="form-label">Elige una foto (JPG, PNG o WebP)</label>
                    <input id="photoFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp">
                    <div class="form-text">Se recorta al centro en forma cuadrada. Solo tú la ves.</div>
                    <div class="text-danger mt-1 d-none" role="alert" data-photo-message></div>

                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-primary d-none" data-photo-save>Guardar foto</button>
                        <form asp-action="RemovePhoto" method="post">
                            @if (photoVersion is not null)
                            {
                                <button type="submit" class="btn btn-outline-danger">Quitar foto</button>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">

        <div class="card-body">
            <h5 class="card-title text.primary">Editar Usuario</h5>

            <form asp-action="UpdateUser" method="POST" class="row g-3" enctype='multipart/form-data'>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Email" />


                <div class="row">

                    <div class="col-md-6 mt-2">
                        <div class="form-floating">
                            <input value="@Model.Email" class="form-control" readonly>
                            <label asp-for="Email"></label>
                        </div>
                    </div>


                    <div class="col-md-6 mt-2">
                        <div class="form-floating">
                            <input asp-for="Document" class="form-control" placeholder="@Html.DisplayFor(dto => dto.Document)" />
                            <label asp-for="Document"></label>
                            <span asp-validation-for="Document" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6 mt-2">
                        <div class="form-floating">
                            <input asp-for="FirstName" class="form-control" placeholder="Nombres">
                            <label asp-for="FirstName"></label>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6 mt-2">
                        <div class="form-floating">
                            <input asp-for="LastName" class="form-control" placeholder="Apellidos">
                            <label asp-for="LastName"></label>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6 mt-2">
                        <div class="form-floating">
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Teléfono">
                            <label asp-for="PhoneNumber"></label>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>
            </form>

        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/profile-photo.js" asp-append-version="true"></script>
}
