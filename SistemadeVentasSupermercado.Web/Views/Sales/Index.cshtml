@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@model PaginationResponse<SaleListItemDTO>

@{
    ViewData["Title"] = "Ventas";
}

<div class="pagetitle">
    <h1>Ventas</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item active">Ventas</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <div class="row">
                <h3 class="m-0 font-weight-bold text-primary col-md-11">Historial de ventas</h3>
                @if (await _usersService.CurrentUserIsAuthorizedAsync("createSales", "Ventas"))
                {
                    <div class="col-md-1">
                        <a asp-action="Create" class="btn btn-primary" title="Nueva venta"><i class="bi bi-cart-plus"></i></a>
                    </div>
                }
            </div>
        </div>

        <div class="card-body mt-3">
            <form asp-action="Index" class="navbar-search" method="GET">
                <input type="hidden" name="Page" value="1" />
                <div class="row mt-3">
                    <div class="col-md-auto">
                        <select name="RecordsPerPage" class="form-select bg-light border-0 small">
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>
                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text" name="Filter" value="@Model.Filter" class="form-control bg-light border-0 small"
                                   placeholder="Número de venta, cliente o cajero..." />
                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered tabla-apilable align-middle">
                    <thead>
                        <tr>
                            <th>N.º</th>
                            <th>Fecha</th>
                            <th>Cajero</th>
                            <th>Cliente</th>
                            <th>Pago</th>
                            <th class="text-end">Total</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.List != null && Model.List.Any())
                        {
                            foreach (SaleListItemDTO item in Model.List)
                            {
                                <tr>
                                    <td>@item.Number</td>
                                    <td>@DisplayFormat.DateTimeColombia(item.CreatedAtUtc)</td>
                                    <td>@item.CashierName</td>
                                    <td>@(item.ClientName ?? "—")</td>
                                    <td>@item.PaymentMethod.Label()</td>
                                    <td class="text-end">@DisplayFormat.Money(item.Total)</td>
                                    <td>
                                        @if (item.Status == SaleStatus.Completed && item.ReturnedTotal >= item.Total && item.Total > 0)
                                        {
                                            <span class="badge bg-warning text-dark">Devuelta</span>
                                        }
                                        else if (item.Status == SaleStatus.Completed && item.ReturnedTotal > 0)
                                        {
                                            <span class="badge bg-success">@item.Status.Label()</span>
                                            <span class="badge bg-warning text-dark" title="Devuelto @DisplayFormat.Money(item.ReturnedTotal)">Con devolución</span>
                                        }
                                        else if (item.Status == SaleStatus.Completed)
                                        {
                                            <span class="badge bg-success">@item.Status.Label()</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status.Label()</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Ver comprobante">
                                            <i class="bi bi-receipt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">No hay ventas registradas.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_PaginationComponent", Model)
        </div>
    </div>
</section>
