@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@model SaleDetailDTO?

@{
    ViewData["Title"] = "Anular o devolver";
    bool hasCancel = await _usersService.CurrentUserIsAuthorizedAsync("cancelSales", "Ventas");
    bool hasReturns = await _usersService.CurrentUserIsAuthorizedAsync("createReturns", "Ventas");
    ViewData["LinkReturns"] = hasReturns || await _usersService.CurrentUserIsAuthorizedAsync("showSales", "Ventas");
    string? cancelReason = ViewBag.CancelReason as string;
    bool openCancel = cancelReason != null || ViewBag.SelectedAuthorizer != null;
}

<div class="pagetitle no-print">
    <h1>Anular o devolver</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item active">Anular o devolver</li>
        </ol>
    </nav>
</div>

<div class="no-print mx-auto" style="max-width: 620px;">
    <partial name="_FormError" />

    <div class="card">
        <div class="card-body pt-3">
            <form asp-action="Assist" method="get">
                <label for="number" class="form-label fw-bold">Número de la venta (está en el comprobante)</label>
                <div class="input-group">
                    <input type="number" min="1" step="1" id="number" name="number" class="form-control" required
                           value="@Model?.Number" autofocus="@(Model == null)" />
                    <button class="btn btn-primary"><i class="bi bi-search"></i> Buscar</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="card">
            <div class="card-body pt-3">
                <div class="d-flex gap-2 flex-wrap">
                    @if (Model.CanBeReturned)
                    {
                        <a asp-controller="SaleReturns" asp-action="@(hasReturns ? "Create" : "CreateWithAuthorization")"
                           asp-route-saleId="@Model.Id" class="btn btn-outline-warning">
                            <i class="bi bi-arrow-return-left"></i> Devolver productos
                        </a>
                    }
                    <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                        <i class="bi bi-printer"></i> Imprimir
                    </button>
                </div>

                @if (Model.CanBeCancelled)
                {
                    <details class="mt-3" open="@openCancel">
                        <summary class="btn btn-outline-danger"><i class="bi bi-x-octagon"></i> Anular venta</summary>
                        <form asp-action="@(hasCancel ? "Cancel" : "CancelWithAuthorization")" asp-route-id="@Model.Id"
                              method="post" id="cancelForm" class="mt-3">
                            <label for="Reason" class="form-label fw-bold">Motivo de la anulación</label>
                            <input type="text" id="Reason" name="Reason" maxlength="200" required class="form-control"
                                   value="@cancelReason" />
                            <div class="form-text">El stock vuelve al inventario. No se puede deshacer.</div>
                            @if (!hasCancel)
                            {
                                <partial name="_SupervisorAuthorization" />
                            }
                            <div class="text-end mt-3">
                                <button type="submit" class="btn btn-danger">Anular la venta N.º @Model.Number</button>
                            </div>
                        </form>
                    </details>
                }
                else if (Model.Status == SaleStatus.Completed)
                {
                    <div class="text-muted small mt-2">
                        Esta venta no se puede anular (tiene devoluciones o su turno de caja ya cerró). Usa una devolución.
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (Model != null)
{
    <partial name="_SaleReceipt" model="Model" />
    <link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />
}
