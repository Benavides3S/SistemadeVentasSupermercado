@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@model SaleDetailDTO

@{
    ViewData["Title"] = $"Venta #{Model.Number}";
    BusinessOptions business = (BusinessOptions)ViewBag.Business;
    bool canCancel = Model.CanBeCancelled && await _usersService.CurrentUserIsAuthorizedAsync("cancelSales", "Ventas");
    bool canReturn = Model.CanBeReturned && await _usersService.CurrentUserIsAuthorizedAsync("createReturns", "Ventas");
}

<div class="pagetitle no-print">
    <h1>Comprobante de venta</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Ventas</a></li>
            <li class="breadcrumb-item active">Venta #@Model.Number</li>
        </ol>
    </nav>
</div>

<div class="no-print mb-3 d-flex gap-2 justify-content-center">
    <button type="button" class="btn btn-primary" onclick="window.print()">
        <i class="bi bi-printer"></i> Imprimir
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al historial</a>
    @if (canReturn)
    {
        <a asp-controller="SaleReturns" asp-action="Create" asp-route-saleId="@Model.Id" class="btn btn-outline-warning">
            <i class="bi bi-arrow-return-left"></i> Devolver productos
        </a>
    }
    @if (canCancel)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" id="cancelForm" class="d-inline">
            <input type="hidden" name="Reason" id="cancelReason" />
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-octagon"></i> Anular venta</button>
        </form>
    }
</div>

@* Ancho pensado para impresora térmica de 80 mm (área imprimible ≈ 72 mm). *@
<div class="receipt">
    <div class="text-center">
        <div class="receipt-title">@business.Nombre</div>
        @if (!string.IsNullOrWhiteSpace(business.Nit))
        {
            <div>NIT @business.Nit</div>
        }
        @if (!string.IsNullOrWhiteSpace(business.Direccion))
        {
            <div>@business.Direccion</div>
        }
        @if (!string.IsNullOrWhiteSpace(business.Telefono))
        {
            <div>Tel. @business.Telefono</div>
        }
    </div>

    <hr />

    <div>Venta N.º <strong>@Model.Number</strong></div>
    <div>Fecha: @DisplayFormat.DateTimeColombia(Model.CreatedAtUtc)</div>
    <div>Cajero: @Model.CashierName</div>
    @if (Model.ClientName != null)
    {
        <div>Cliente: @Model.ClientName</div>
    }
    @if (Model.Status == SaleStatus.Cancelled)
    {
        <div class="receipt-banner">*** VENTA ANULADA ***</div>
        @if (Model.CancelledAtUtc.HasValue)
        {
            <div>Anulada: @DisplayFormat.DateTimeColombia(Model.CancelledAtUtc.Value)</div>
        }
        @if (Model.CancelledByName != null)
        {
            <div>Por: @Model.CancelledByName</div>
        }
        @if (Model.CancelReason != null)
        {
            <div>Motivo: @Model.CancelReason</div>
        }
    }

    <hr />

    @foreach (SaleDetailLineDTO line in Model.Items)
    {
        <div class="receipt-line">
            <div>@line.ProductName</div>
            <div class="d-flex justify-content-between">
                <span>@DisplayFormat.Quantity(line.Quantity) @line.Unit.Abbreviation() × @DisplayFormat.Money(line.UnitPrice)</span>
                <span>@DisplayFormat.Money(line.Total)</span>
            </div>
        </div>
    }

    <hr />

    <div class="d-flex justify-content-between receipt-total">
        <span>TOTAL</span>
        <span>@DisplayFormat.Money(Model.Total)</span>
    </div>
    <div class="d-flex justify-content-between">
        <span>Pago</span>
        <span>@Model.PaymentMethod.Label()</span>
    </div>

    @if (Model.Returns.Any())
    {
        <hr />
        <div class="fw-bold">Devoluciones</div>
        @foreach (SaleReturnSummaryDTO ret in Model.Returns)
        {
            <div class="d-flex justify-content-between">
                <span>
                    <a asp-controller="SaleReturns" asp-action="Details" asp-route-id="@ret.Id">N.º @ret.Number</a>
                    @DisplayFormat.ToColombiaTime(ret.CreatedAtUtc).ToString("dd/MM/yyyy")
                </span>
                <span>− @DisplayFormat.Money(ret.Total)</span>
            </div>
        }
        <div class="d-flex justify-content-between fw-bold">
            <span>Neto</span>
            <span>@DisplayFormat.Money(Model.Total - Model.ReturnedTotal)</span>
        </div>
    }

    <hr />

    <div class="text-center small">
        Este documento no es una factura electrónica.<br />
        ¡Gracias por su compra!
    </div>
</div>

<link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />

@section Scripts {
    <script>
        // Pide el motivo antes de anular (obligatorio, máximo 200 caracteres).
        const cancelForm = document.getElementById('cancelForm');
        if (cancelForm) {
            cancelForm.addEventListener('submit', function (event) {
                if (cancelForm.dataset.confirmed === 'true') return;
                event.preventDefault();

                Swal.fire({
                    icon: 'warning',
                    title: '¿Anular la venta #@Model.Number?',
                    text: 'El stock de los productos volverá al inventario. No se puede deshacer.',
                    input: 'text',
                    inputLabel: 'Motivo de la anulación',
                    inputAttributes: { maxlength: '200' },
                    showCancelButton: true,
                    confirmButtonText: 'Sí, anular',
                    cancelButtonText: 'No',
                    inputValidator: value => (!value || !value.trim()) ? 'El motivo es obligatorio' : undefined
                }).then(result => {
                    if (result.isConfirmed) {
                        document.getElementById('cancelReason').value = result.value.trim();
                        cancelForm.dataset.confirmed = 'true';
                        cancelForm.submit();
                    }
                });
            });
        }
    </script>
}
