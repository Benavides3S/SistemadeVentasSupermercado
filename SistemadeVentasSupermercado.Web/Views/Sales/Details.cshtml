@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@model SaleDetailDTO

@{
    ViewData["Title"] = $"Venta #{Model.Number}";
    bool canCancel = Model.CanBeCancelled && await _usersService.CurrentUserIsAuthorizedAsync("cancelSales", "Ventas");
    bool canReturn = Model.CanBeReturned && await _usersService.CurrentUserIsAuthorizedAsync("createReturns", "Ventas");
}

<div class="pagetitle no-print">
    <h1>Comprobante de venta</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Ventas</a></li>
            <li class="breadcrumb-item active">Venta #@Model.Number</li>
        </ol>
    </nav>
</div>

<div class="no-print mb-3 d-flex gap-2 justify-content-center">
    <button type="button" class="btn btn-primary" onclick="window.print()">
        <i class="bi bi-printer"></i> Imprimir
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al historial</a>
    @if (canReturn)
    {
        <a asp-controller="SaleReturns" asp-action="Create" asp-route-saleId="@Model.Id" class="btn btn-outline-warning">
            <i class="bi bi-arrow-return-left"></i> Devolver productos
        </a>
    }
    @if (canCancel)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" id="cancelForm" class="d-inline">
            <input type="hidden" name="Reason" id="cancelReason" />
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-octagon"></i> Anular venta</button>
        </form>
    }
</div>

<partial name="_SaleReceipt" model="Model" />

<link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />

@section Scripts {
    <script>
        // Pide el motivo antes de anular (obligatorio, máximo 200 caracteres).
        const cancelForm = document.getElementById('cancelForm');
        if (cancelForm) {
            cancelForm.addEventListener('submit', function (event) {
                if (cancelForm.dataset.confirmed === 'true') return;
                event.preventDefault();

                Swal.fire({
                    icon: 'warning',
                    title: '¿Anular la venta #@Model.Number?',
                    text: 'El stock de los productos volverá al inventario. No se puede deshacer.',
                    input: 'text',
                    inputLabel: 'Motivo de la anulación',
                    inputAttributes: { maxlength: '200' },
                    showCancelButton: true,
                    confirmButtonText: 'Sí, anular',
                    cancelButtonText: 'No',
                    inputValidator: value => (!value || !value.trim()) ? 'El motivo es obligatorio' : undefined
                }).then(result => {
                    if (result.isConfirmed) {
                        document.getElementById('cancelReason').value = result.value.trim();
                        cancelForm.dataset.confirmed = 'true';
                        cancelForm.submit();
                    }
                });
            });
        }
    </script>
}
