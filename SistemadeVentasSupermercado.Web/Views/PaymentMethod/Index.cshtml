@inject SistemadeVentasSupermercado.Web.Services.Abstractions.IUsersService _usersService
@using SistemadeVentasSupermercado.Web.Core.Pagination
@model PaginationResponse<SistemadeVentasSupermercado.Web.DTOs.PaymentMethodDTO>

@{
    ViewData["Title"] = "Métodos de Pago";
}

<div class="pagetitle">
    <h1>Métodos de Pago</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Inicio</a></li>
            <li class="breadcrumb-item active">Métodos de Pago</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">

        <div class="card-header">
            <div class="row">
                <h3 class="m-0 font-weight-bold text-primary col-md-11">Métodos de Pago</h3>

                @if (await _usersService.CurrentUserIsAuthorizedAsync("createPaymentMethods", "Configuración"))
                {
                    <div class="col-md-1">
                        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i></a>
                    </div>
                }
            </div>
        </div>

        <div class="card-body mt-3">

            @* Formulario de búsqueda y paginación *@
            <form asp-action="Index" class="navbar-search" method="GET">
                <input type="hidden" name="Page" value="@Model.CurrentPage" />

                <div class="row mt-3">
                    <div class="col-md-auto">
                        <select name="RecordsPerPage" class="form-select bg-light border-0 small" asp-for="RecordsPerPage">
                            <option value="2" selected="@(Model.RecordsPerPage == 2)">2</option>
                            <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                            <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                            <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                            <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                        </select>
                    </div>

                    <div class="col-md-10">
                        <div class="input-group mb-3">
                            <input type="text"
                                   class="form-control bg-light border-0 small"
                                   placeholder="Buscar método de pago..."
                                   aria-label="search"
                                   asp-for="Filter" />
                            <button class="btn btn-primary"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
            </form>

            @* Tabla de Métodos de Pago *@
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Comisión</th>
                        <th>Requiere Terminal</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.List != null && Model.List.Any())
                    {
                        foreach (var item in Model.List)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@(item.Description ?? "N/A")</td>
                                <td>@item.CommissionPercentage.ToString("P2")</td>
                                <td>
                                    @if (item.RequiresTerminal)
                                    {
                                        <span class="badge bg-info">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    @if (await _usersService.CurrentUserIsAuthorizedAsync("updatePaymentMethods", "Configuración"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    }

                                    @if (await _usersService.CurrentUserIsAuthorizedAsync("deletePaymentMethods", "Configuración"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" style="display: contents;">
                                            <button class="btn btn-sm btn-danger btnDelete">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay métodos de pago registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>

            @* Componente de paginación *@
            @await Html.PartialAsync("_PaginationComponent", Model)

        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btnDelete').click(function(event) {
                event.preventDefault();
                Swal.fire({
                    icon: "question",
                    title: "¿Desea eliminar el método de pago?",
                    text: "No podrá revertirlo",
                    showCancelButton: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = $(this).closest('form');
                        form.submit();
                    }
                });
            });
        });
    </script>
}