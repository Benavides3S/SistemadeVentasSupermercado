# Copia este archivo con el nombre .env y cambia los valores.
# El archivo .env tiene contraseñas: NUNCA se sube a git (ya está en .gitignore).
# Escribe cada valor sin comillas y sin comentarios en la misma línea.

# Contraseña del usuario "sa" de SQL Server. Mínimo 8 caracteres con mayúsculas, minúsculas y números.
# Usa solo letras, números y - _ . @  (evita ; $ " ' y espacios: dañan la cadena de conexión).
MSSQL_SA_PASSWORD=

# Edición de SQL Server: Express (producción, gratis) o Developer (solo desarrollo y pruebas).
MSSQL_PID=Express

# Nombre de la base de datos.
DB_NAME=SistemaVentasSuperMercado

# Puerto de la aplicación en este computador: http://<ip-del-servidor>:8080
APP_PORT=8080

# Puerto de SQL Server, solo para este computador (Management Studio: localhost,14330).
DB_PORT=14330

# Contraseña de los usuarios iniciales (solo se usa la primera vez que arranca la aplicación).
# Reglas: mínimo 8 caracteres, mayúscula, minúscula, número y 4 caracteres distintos.
SEED_PASSWORD_INICIAL=

# Datos del negocio para los comprobantes.
NEGOCIO_NOMBRE=Supermercado
NEGOCIO_NIT=
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=

# Minutos sin uso para bloquear la pantalla (0 = sin bloqueo automático).
MINUTOS_INACTIVIDAD=5
